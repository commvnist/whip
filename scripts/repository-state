#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf '%s\n' \
        'Create and verify a deterministic manifest of repository inputs.' \
        '' \
        'Usage:' \
        '  scripts/repository-state manifest OUTPUT' \
        '  scripts/repository-state signature' \
        '  scripts/repository-state verify EXPECTED_SHA256'
}

emit_manifest() {
    local path relative_path kind mode digest bytes
    while IFS= read -r -d '' path; do
        relative_path="${path#./}"
        [[ "$relative_path" != *$'\n'* && "$relative_path" != *$'\t'* ]] ||
            die "repository input path contains a tab or newline: $relative_path"
        if [[ -L "$relative_path" ]]; then
            kind='symlink'
            mode='120000'
            digest="$(readlink -- "$relative_path" | sha256sum | awk '{ print $1 }')"
            bytes="$(readlink -- "$relative_path" | wc -c | tr -d ' ')"
        elif [[ -f "$relative_path" ]]; then
            kind='file'
            mode="$(git ls-files -s -- "$relative_path" | awk 'NR == 1 { print $1 }')"
            if [[ -z "$mode" ]]; then
                if [[ -x "$relative_path" ]]; then mode='100755'; else mode='100644'; fi
            fi
            digest="$(sha256sum -- "$relative_path" | awk '{ print $1 }')"
            bytes="$(wc -c < "$relative_path" | tr -d ' ')"
        else
            kind='absent'
            mode="$(git ls-files -s -- "$relative_path" | awk 'NR == 1 { print $1 }')"
            [[ -n "$mode" ]] || mode='000000'
            digest='-'
            bytes='0'
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$mode" "$bytes" "$digest" "$relative_path"
    done < <(
        {
            git ls-files -z
            git ls-files --others --exclude-standard -z
        } | sort -zu
    )
}

manifest_signature() {
    emit_manifest | sha256sum | awk '{ print $1 }'
}

cd "$PROJECT_ROOT"
case "${1:-}" in
    manifest)
        [[ "$#" -eq 2 && -n "$2" ]] || { usage >&2; exit 2; }
        mkdir -p -- "$(dirname -- "$2")"
        emit_manifest > "$2"
        ;;
    signature)
        [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
        manifest_signature
        ;;
    verify)
        [[ "$#" -eq 2 && "$2" =~ ^[0-9a-f]{64}$ ]] || { usage >&2; exit 2; }
        actual_signature="$(manifest_signature)"
        [[ "$actual_signature" == "$2" ]] ||
            die "repository inputs changed: expected $2, found $actual_signature"
        printf 'Repository input signature matches %s.\n' "$2"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
