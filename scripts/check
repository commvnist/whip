#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

run_emulator_tests=false
build_release=false

usage() {
    printf '%s\n' \
        'Run Whip automated quality gates.' \
        '' \
        'Usage:' \
        '  scripts/check             Unit tests, Android-test compilation, lint, debug APK' \
        '  scripts/check --emulator  Also run instrumentation tests on one disposable emulator' \
        '  scripts/check --device    Backwards-compatible alias for --emulator' \
        '  scripts/check --full      Also build release and the optimized benchmark harness' \
        '' \
        'Instrumentation reinstalls/clears the debug app. Physical devices are refused.' \
        'Set ANDROID_SERIAL to an API 34+ disposable emulator, or connect exactly one emulator.'
}

while (($#)); do
    case "$1" in
        --device|--emulator) run_emulator_tests=true ;;
        --full) build_release=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; printf 'error: unknown option %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

tasks=(
    :app:createDebugUnitTestCoverageReport
    :app:compileDebugAndroidTestKotlin
    :app:lintDebug
    :app:assembleDebug
)
if [[ "$build_release" == true ]]; then
    tasks+=(:app:assembleRelease :app:bundleRelease :benchmark:assembleBenchmark)
fi

cd "$PROJECT_ROOT"

jvm_test_count="$(grep -RhoE --include='*.kt' '^[[:space:]]*@Test([[:space:](]|$)' app/src/test | wc -l | tr -d ' ')"
android_test_count="$(grep -RhoE --include='*.kt' '^[[:space:]]*@Test([[:space:](]|$)' app/src/androidTest | wc -l | tr -d ' ')"
product_test_count="$((jvm_test_count + android_test_count))"
documented_baseline="Current baseline: ${product_test_count} product tests—${jvm_test_count} fast JVM tests and ${android_test_count} Android"
if ! grep -Fq "$documented_baseline" docs/testing.md; then
    printf 'error: docs/testing.md test baseline is stale; expected: %s instrumentation tests\n' "$documented_baseline" >&2
    exit 1
fi

java scripts/RenderBrandIcon.java --verify

unexpected_device_paths="$(
    rg -n '/sdcard|/storage/emulated/0|/data/local/tmp' app/src benchmark/src scripts \
        --glob '!scripts/device-artifacts' \
        --glob '!scripts/check' \
        --glob '!**/build/**' || true
)"
if [[ -n "$unexpected_device_paths" ]]; then
    printf 'error: direct device-root artifact path bypasses scripts/device-artifacts:\n%s\n' "$unexpected_device_paths" >&2
    exit 1
fi

if rg -n 'fallbackToDestructiveMigration' app/src/main; then
    printf 'error: destructive Room migration fallback is forbidden\n' >&2
    exit 1
fi

./gradlew "${tasks[@]}"
java scripts/CoverageGate.java unit app/build/reports/coverage/test/debug/report.xml

merged_manifest="$(find app/build/intermediates/merged_manifests/debug -name AndroidManifest.xml -print -quit)"
if [[ -z "$merged_manifest" ]]; then
    printf 'error: debug merged manifest was not produced\n' >&2
    exit 1
fi
if grep -Eq 'android\.permission\.ACCESS_(BACKGROUND_LOCATION|COARSE_LOCATION|FINE_LOCATION)' "$merged_manifest"; then
    printf 'error: retired location permission found in merged manifest: %s\n' "$merged_manifest" >&2
    exit 1
fi

if [[ "$build_release" == true ]]; then
    release_apk="$(find app/build/outputs/apk/release -maxdepth 1 -name '*.apk' -print -quit)"
    release_bundle="app/build/outputs/bundle/release/app-release.aab"
    readonly release_apk release_bundle
    readonly release_metadata="app/build/outputs/apk/release/output-metadata.json"
    for artifact in "$release_apk" "$release_bundle" "$release_metadata"; do
        if [[ ! -s "$artifact" ]]; then
            printf 'error: expected release artifact is missing or empty: %s\n' "$artifact" >&2
            exit 1
        fi
    done
    grep -Fq '"applicationId": "commvne.com.whip.app"' "$release_metadata" || {
        printf 'error: release artifact has the wrong application ID\n' >&2
        exit 1
    }
    grep -Fq '"versionCode": 29' "$release_metadata" || {
        printf 'error: release artifact has the wrong version code\n' >&2
        exit 1
    }
fi

if [[ "$run_emulator_tests" == true ]]; then
    command -v adb >/dev/null 2>&1 || {
        printf 'error: adb is required for --emulator\n' >&2
        exit 1
    }

    if [[ -n "${ANDROID_SERIAL:-}" ]]; then
        test_serial="$ANDROID_SERIAL"
        if ! adb -s "$test_serial" get-state 2>/dev/null | grep -qx device; then
            printf 'error: ANDROID_SERIAL is not a connected device: %s\n' "$test_serial" >&2
            exit 1
        fi
    else
        mapfile -t connected_serials < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
        if [[ "${#connected_serials[@]}" -ne 1 ]]; then
            printf 'error: set ANDROID_SERIAL to one disposable emulator; found %s connected devices\n' "${#connected_serials[@]}" >&2
            exit 1
        fi
        test_serial="${connected_serials[0]}"
    fi

    readonly test_serial
    if [[ "$(adb -s "$test_serial" shell getprop ro.boot.qemu | tr -d '\r')" != "1" ]]; then
        printf 'error: refusing to run destructive instrumentation on physical device %s\n' "$test_serial" >&2
        exit 1
    fi

    emulator_api="$(adb -s "$test_serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ ! "$emulator_api" =~ ^[0-9]+$ ]] || ((emulator_api < 34)); then
        printf 'error: instrumentation requires an API 34+ emulator; %s reports API %s\n' "$test_serial" "$emulator_api" >&2
        exit 1
    fi

    mapfile -t instrumentation_test_files < <(find app/src/androidTest -name '*Test.kt' -type f | sort)
    instrumentation_classes=()
    for test_file in "${instrumentation_test_files[@]}"; do
        test_package="$(sed -nE 's/^package[[:space:]]+([^[:space:]]+).*/\1/p' "$test_file" | head -n 1)"
        test_class="$(basename "$test_file" .kt)"
        if [[ -z "$test_package" ]] || ! grep -Eq "^(internal[[:space:]]+)?class[[:space:]]+${test_class}([[:space:]:<{]|$)" "$test_file"; then
            printf 'error: instrumentation test file must declare its filename as a top-level class: %s\n' "$test_file" >&2
            exit 1
        fi
        instrumentation_classes+=("${test_package}.${test_class}")
    done
    if [[ "${#instrumentation_classes[@]}" -eq 0 ]]; then
        printf 'error: no instrumentation test classes found\n' >&2
        exit 1
    fi

    # Long Compose runs can exhaust host-emulator graphics state even when every
    # assertion is healthy. Run the canvas/color interaction suite first on the
    # fresh AVD, then use class batches so the runner and app process get clean
    # lifecycles without turning every test into a separate install cycle.
    readonly graphics_test_class='com.whip.app.ui.InteractionControlUiTest'
    remaining_instrumentation_classes=()
    graphics_test_found=false
    for test_class in "${instrumentation_classes[@]}"; do
        if [[ "$test_class" == "$graphics_test_class" ]]; then
            graphics_test_found=true
        else
            remaining_instrumentation_classes+=("$test_class")
        fi
    done
    readonly instrumentation_batch_size=10
    batch_total="$(((${#remaining_instrumentation_classes[@]} + instrumentation_batch_size - 1) / instrumentation_batch_size))"
    instrumentation_run_dir="$(mktemp -d "${PROJECT_ROOT}/build/instrumentation-results-XXXXXX")"
    readonly instrumentation_run_dir
    aggregate_result="${instrumentation_run_dir}/aggregate.tsv"
    readonly aggregate_result
    printf 'batch\texpected_classes\texecuted_classes\texecuted\tskipped\n' > "$aggregate_result"
    executed_test_total=0
    skipped_test_total=0

    capture_instrumentation_batch() {
        local batch_number="$1"
        local expected_class_argument="$2"
        local batch_report_dir="${instrumentation_run_dir}/batch-${batch_number}"
        mkdir -p "$batch_report_dir"
        mapfile -t batch_xml < <(find app/build/outputs/androidTest-results/connected -name 'TEST-*.xml' -type f 2>/dev/null | sort)
        if [[ "${#batch_xml[@]}" -eq 0 ]]; then
            printf 'error: instrumentation batch %s produced no executable XML results\n' "$batch_number" >&2
            exit 1
        fi
        for result_xml in "${batch_xml[@]}"; do
            cp "$result_xml" "$batch_report_dir/"
        done
        local expected_class_file="${batch_report_dir}/expected-classes.txt"
        local executed_class_file="${batch_report_dir}/executed-classes.txt"
        tr ',' '\n' <<< "$expected_class_argument" | sed '/^$/d' | sort -u > "$expected_class_file"
        (grep -Rho 'classname="[^"]*"' "$batch_report_dir" || true) \
            | sed -E 's/^classname="([^"]*)"$/\1/' \
            | sed '/^$/d' \
            | sort -u > "$executed_class_file"
        if ! cmp -s "$expected_class_file" "$executed_class_file"; then
            printf 'error: instrumentation batch %s executed a different class set than requested\n' "$batch_number" >&2
            diff -u "$expected_class_file" "$executed_class_file" >&2 || true
            exit 1
        fi
        local expected_class_count executed_class_count executed skipped
        expected_class_count="$(wc -l < "$expected_class_file" | tr -d ' ')"
        executed_class_count="$(wc -l < "$executed_class_file" | tr -d ' ')"
        executed="$( (grep -Rho '<testcase[ >]' "$batch_report_dir" || true) | wc -l | tr -d ' ')"
        skipped="$( (grep -Rho '<skipped[ >]' "$batch_report_dir" || true) | wc -l | tr -d ' ')"
        if [[ "$executed" -eq 0 ]]; then
            printf 'error: instrumentation batch %s reported zero executed tests\n' "$batch_number" >&2
            exit 1
        fi
        executed_test_total="$((executed_test_total + executed))"
        skipped_test_total="$((skipped_test_total + skipped))"
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$batch_number" "$expected_class_count" "$executed_class_count" "$executed" "$skipped" >> "$aggregate_result"
    }

    run_instrumentation_batch() {
        local batch_number="$1"
        local class_argument="$2"
        local gradle_status
        set +e
        ANDROID_SERIAL="$test_serial" ./gradlew :app:connectedDebugAndroidTest \
            "-Pandroid.testInstrumentationRunnerArguments.class=${class_argument}"
        gradle_status="$?"
        set -e
        capture_instrumentation_batch "$batch_number" "$class_argument"
        if [[ "$gradle_status" -ne 0 ]]; then
            printf 'error: instrumentation batch %s failed; results retained in %s\n' "$batch_number" "$instrumentation_run_dir" >&2
            exit "$gradle_status"
        fi
        adb -s "$test_serial" shell am force-stop commvne.com.whip.app.debug >/dev/null
        adb -s "$test_serial" shell am force-stop commvne.com.whip.app.debug.test >/dev/null
    }

    if [[ "$graphics_test_found" == true ]]; then
        batch_total="$((batch_total + 1))"
        printf 'Instrumentation batch 1/%s (graphics interaction class)\n' "$batch_total"
        run_instrumentation_batch 1 "$graphics_test_class"
    fi

    for ((batch_start = 0; batch_start < ${#remaining_instrumentation_classes[@]}; batch_start += instrumentation_batch_size)); do
        batch=("${remaining_instrumentation_classes[@]:batch_start:instrumentation_batch_size}")
        batch_classes="$(IFS=,; printf '%s' "${batch[*]}")"
        batch_number="$((batch_start / instrumentation_batch_size + 1))"
        if [[ "$graphics_test_found" == true ]]; then
            batch_number="$((batch_number + 1))"
        fi
        printf 'Instrumentation batch %s/%s (%s classes)\n' "$batch_number" "$batch_total" "${#batch[@]}"
        run_instrumentation_batch "$batch_number" "$batch_classes"
    done
    if [[ "$executed_test_total" -ne "$android_test_count" ]]; then
        printf 'error: expected %s Android tests from source but XML proves %s executed; see %s\n' \
            "$android_test_count" "$executed_test_total" "$aggregate_result" >&2
        exit 1
    fi
    if [[ "$skipped_test_total" -ne 0 ]]; then
        printf 'error: %s Android tests were skipped; see %s\n' "$skipped_test_total" "$aggregate_result" >&2
        exit 1
    fi
    printf 'All %s Android instrumentation tests executed with zero skips across %s batches. Aggregate: %s\n' \
        "$executed_test_total" "$batch_total" "$aggregate_result"
fi
