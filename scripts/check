#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

run_emulator=false
explain_only=false
route_all=false
full_gate=false
fresh_emulator=false
routing_requested=false
router_args=(--format tsv)

usage() {
    printf '%s\n' \
        'Run the proportionate Whip development/change gate.' \
        '' \
        'Usage:' \
        '  scripts/check [--base REF] [--emulator]' \
        '  scripts/check --path PATH [--path PATH ...] [--emulator]' \
        '  scripts/check --changes-file FILE [--emulator]' \
        '  scripts/check --all [--emulator]' \
        '  scripts/check --explain [routing options]' \
        '  scripts/check --full [--emulator [--fresh-emulator]]' \
        '' \
        'Changed paths are unioned and deduplicated into exact selectors/profiles.' \
        'Unknown production/build/harness inputs fail closed to scripts/candidate.' \
        '--full preserves the complete device-independent JVM/static/build gate.' \
        '--device aliases --emulator; --fresh-emulator requires --emulator.' \
        'Only an explicit scripts/candidate command creates fresh candidate evidence.'
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

run_complete_local_gate() {
    cd "$PROJECT_ROOT"

    jvm_test_count="$(grep -RhoE --include='*.kt' '^[[:space:]]*@Test([[:space:](]|$)' app/src/test | wc -l | tr -d ' ')"
    android_test_count="$(grep -RhoE --include='*.kt' '^[[:space:]]*@Test([[:space:](]|$)' app/src/androidTest | wc -l | tr -d ' ')"
    product_test_count="$((jvm_test_count + android_test_count))"
    documented_baseline="Current baseline: ${product_test_count} product tests—${jvm_test_count} fast JVM tests and ${android_test_count} Android"
    grep -Fq "$documented_baseline" docs/testing.md ||
        die "docs/testing.md test baseline is stale; expected: $documented_baseline instrumentation tests"

    java scripts/RenderBrandIcon.java --verify
    unexpected_device_paths="$(
        rg -n '/sdcard|/storage/emulated/0|/data/local/tmp' app/src benchmark/src scripts \
            --glob '!scripts/device-artifacts' --glob '!scripts/check' --glob '!scripts/candidate' \
            --glob '!scripts/test-*' --glob '!**/build/**' || true
    )"
    [[ -z "$unexpected_device_paths" ]] ||
        die "direct device-root artifact path bypasses scripts/device-artifacts: $unexpected_device_paths"
    if rg -n 'fallbackToDestructiveMigration' app/src/main; then
        die 'destructive Room migration fallback is forbidden'
    fi

    ./gradlew \
        :app:createDebugUnitTestCoverageReport \
        :app:compileDebugAndroidTestKotlin \
        :app:lintDebug \
        :app:assembleDebug \
        :app:assembleRelease \
        :app:bundleRelease \
        :benchmark:assembleBenchmark
    java scripts/CoverageGate.java unit app/build/reports/coverage/test/debug/report.xml

    merged_manifest="$(find app/build/intermediates/merged_manifests/debug -name AndroidManifest.xml -print -quit)"
    [[ -n "$merged_manifest" && -s "$merged_manifest" ]] ||
        die 'debug merged manifest was not produced'
    if grep -Eq 'android\.permission\.ACCESS_(BACKGROUND_LOCATION|COARSE_LOCATION|FINE_LOCATION)' "$merged_manifest"; then
        die "retired location permission found in merged manifest: $merged_manifest"
    fi

    expected_release_version_code="$(
        sed -nE 's/^[[:space:]]*versionCode[[:space:]]*=[[:space:]]*([0-9]+).*$/\1/p' \
            app/build.gradle.kts | head -n 1
    )"
    [[ -n "$expected_release_version_code" ]] ||
        die 'could not read the expected release version code from app/build.gradle.kts'
    release_apk="$(find app/build/outputs/apk/release -maxdepth 1 -name '*.apk' -type f -print -quit)"
    release_bundle='app/build/outputs/bundle/release/app-release.aab'
    release_metadata='app/build/outputs/apk/release/output-metadata.json'
    for release_artifact in "$release_apk" "$release_bundle" "$release_metadata"; do
        [[ -n "$release_artifact" && -s "$release_artifact" ]] ||
            die "expected release artifact is missing or empty: $release_artifact"
    done
    grep -Fq '"applicationId": "commvne.com.whip.app"' "$release_metadata" ||
        die 'release artifact has the wrong application ID'
    grep -Fq "\"versionCode\": $expected_release_version_code" "$release_metadata" ||
        die "release artifact has the wrong version code; expected $expected_release_version_code"

    git diff --check
}

while (($#)); do
    case "$1" in
        --emulator|--device) run_emulator=true ;;
        --explain) explain_only=true ;;
        --all) route_all=true; routing_requested=true ;;
        --full) full_gate=true ;;
        --fresh-emulator) fresh_emulator=true ;;
        --base|--path|--changes-file)
            option="$1"
            routing_requested=true
            shift
            (($#)) || die "$option requires a value"
            router_args+=("$option" "$1")
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "unknown option $1" ;;
    esac
    shift
done

if [[ "$fresh_emulator" == true && "$run_emulator" != true ]]; then
    die '--fresh-emulator requires --emulator'
fi
if [[ "$full_gate" == true ]]; then
    [[ "$explain_only" != true && "$routing_requested" != true ]] ||
        die '--full cannot be combined with routing or explain options'
    if [[ "$run_emulator" == true ]]; then
        "${SCRIPT_DIR}/android-target-guard" instrumentation
    fi
    run_complete_local_gate
    if [[ "$run_emulator" == true ]]; then
        android_mode='reusable'
        [[ "$fresh_emulator" != true ]] || android_mode='fresh'
        "${SCRIPT_DIR}/android-test-engine" --mode "$android_mode"
    fi
    printf 'Complete local quality/build gate passed%s. Frozen-candidate evidence was not created.\n' \
        "$([[ "$run_emulator" == true ]] && printf ' with Android instrumentation' || true)"
    exit 0
fi
if [[ "$run_emulator" == true ]]; then
    "${SCRIPT_DIR}/android-target-guard" instrumentation
fi

cd "$PROJECT_ROOT"
route_file="$(mktemp)"
trap 'rm -f -- "$route_file"' EXIT
if [[ "$route_all" == true ]]; then
    printf '%s\n' \
        $'ROUTE\tM\t(explicit --all)\tprofile:all\tcaller requested all development profiles' \
        $'PROFILE\tall' \
        $'JVM_ALL\tfalse' \
        $'ANDROID_ALL\tfalse' \
        $'STATIC\ttrue' \
        $'CANDIDATE\tfalse' > "$route_file"
else
    "${SCRIPT_DIR}/change-router" "${router_args[@]}" > "$route_file"
fi

awk -F '\t' '$1 == "ROUTE" { printf "Route %s %s -> %s (%s)\n", $2, $3, $4, $5 }' "$route_file"
awk -F '\t' '$1 == "PROFILE" { print "Profile: " $2 }' "$route_file"
awk -F '\t' '$1 == "JVM" { print "JVM selector: " $2 }' "$route_file"
awk -F '\t' '$1 == "ANDROID" { print "Android selector: " $2 }' "$route_file"
candidate_required="$(awk -F '\t' '$1 == "CANDIDATE" { print $2 }' "$route_file")"
static_required="$(awk -F '\t' '$1 == "STATIC" { print $2 }' "$route_file")"
jvm_all="$(awk -F '\t' '$1 == "JVM_ALL" { print $2 }' "$route_file")"
android_all="$(awk -F '\t' '$1 == "ANDROID_ALL" { print $2 }' "$route_file")"
printf 'All JVM tests: %s\nAll Android tests: %s\nStatic checks: %s\nFrozen candidate required: %s\n' \
    "$jvm_all" "$android_all" "$static_required" "$candidate_required"

if [[ "$explain_only" == true ]]; then exit 0; fi
[[ "$candidate_required" != true ]] ||
    die 'this change touches frozen-candidate inputs; run ANDROID_SERIAL=emulator-N scripts/candidate'

qa_args=()
while IFS=$'\t' read -r record value _; do
    case "$record" in
        PROFILE) [[ "$value" == docs ]] || qa_args+=(--profile "$value") ;;
        JVM) qa_args+=(--jvm "$value") ;;
        ANDROID)
            if [[ "$run_emulator" == true && "$fresh_emulator" != true ]]; then
                qa_args+=(--android "$value")
            fi
            ;;
    esac
done < "$route_file"
[[ "$jvm_all" != true ]] || qa_args+=(--all-jvm)
if [[ "$android_all" == true ]]; then
    qa_args+=(--all-android)
    [[ "$run_emulator" != true || "$fresh_emulator" == true ]] || qa_args+=(--emulator)
elif [[ "$run_emulator" == true && "$fresh_emulator" != true ]]; then
    qa_args+=(--emulator)
fi

android_selector_count="$(awk -F '\t' '$1 == "ANDROID" { count++ } END { print count + 0 }' "$route_file")"
if [[ "${#qa_args[@]}" -gt 0 ]]; then
    "${SCRIPT_DIR}/qa-targeted" "${qa_args[@]}"
elif [[ "$android_selector_count" -gt 0 ]]; then
    ./gradlew :app:compileDebugAndroidTestKotlin
fi
if [[ "$run_emulator" != true && "$android_selector_count" -gt 0 && "${#qa_args[@]}" -gt 0 ]]; then
    ./gradlew :app:compileDebugAndroidTestKotlin
fi
if [[ "$fresh_emulator" == true ]]; then
    "${SCRIPT_DIR}/android-test-engine" --mode fresh
fi

if [[ "$static_required" == true ]]; then
    java scripts/RenderBrandIcon.java --verify
    if rg -n 'fallbackToDestructiveMigration' app/src/main; then
        die 'destructive Room migration fallback is forbidden'
    fi
    ./gradlew :app:lintDebug :app:assembleDebug
fi
git diff --check
printf 'Proportionate change gate passed. Frozen-candidate evidence was not created.\n'
