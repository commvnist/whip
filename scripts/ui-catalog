#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
readonly CATALOG_FILE="${WHIP_UI_CATALOG_FILE:-${PROJECT_ROOT}/docs/quality/ui-surface-catalog.tsv}"
readonly SOURCE_SNAPSHOT_FILE="${WHIP_UI_SOURCE_SNAPSHOT_FILE:-${PROJECT_ROOT}/docs/quality/ui-source-snapshot.tsv}"
readonly SOURCE_ROOT="${WHIP_UI_SOURCE_ROOT:-${PROJECT_ROOT}/app/src/main/java/com/whip/app}"
readonly DEVICE_CAPTURE_ROOT="/sdcard/Download/whip-ui-catalog"
readonly DEVICE_CAPTURE_RELATIVE_PATH="Download/whip-ui-catalog/"
readonly DEVICE_DOWNLOADS_URI="content://media/external_primary/downloads"
capture_serial=''
capture_previous_night_mode=''
capture_previous_hide_error_dialogs=''

usage() {
    cat <<'EOF'
Inventory and capture Whip's user-visible pages, dialogs, and menus.

Usage:
  scripts/ui-catalog discover
  scripts/ui-catalog source-snapshot
  scripts/ui-catalog lint [--allow-pending]
  scripts/ui-catalog report CAPTURE_DIRECTORY
  ANDROID_SERIAL=emulator-5554 scripts/ui-catalog capture [--allow-pending] [--family FAMILY] OUTPUT_DIRECTORY

The catalog is docs/quality/ui-surface-catalog.tsv. Capture is emulator-only,
runs every unique catalog test selector, pulls app-private PNG/XML evidence,
and fails if any required surface is missing or any uncatalogued artifact exists.
Each accepted capture includes a searchable, dependency-free index.html review gallery.
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

restore_capture_environment() {
    if [[ -n "$capture_serial" && "$capture_previous_night_mode" =~ ^(yes|no|auto)$ ]]; then
        adb -s "$capture_serial" shell cmd uimode night "$capture_previous_night_mode" >/dev/null || true
    fi
    if [[ -n "$capture_serial" ]]; then
        case "$capture_previous_hide_error_dialogs" in
            null) adb -s "$capture_serial" shell settings delete global hide_error_dialogs >/dev/null || true ;;
            0|1) adb -s "$capture_serial" shell settings put global hide_error_dialogs "$capture_previous_hide_error_dialogs" >/dev/null || true ;;
        esac
    fi
}

family_for_file() {
    case "$1" in
        *Task*|WhipApp.kt) printf 'tasks\n' ;;
        *Habit*) printf 'habits\n' ;;
        *Goal*) printf 'goals\n' ;;
        *Track*) printf 'tracks\n' ;;
        *Gym*|*Routine*|*FiveThreeOne*) printf 'gym\n' ;;
        *Settings*|*Startup*|*Health*) printf 'settings\n' ;;
        *Area*|*Tag*) printf 'organization\n' ;;
        *) printf 'shared\n' ;;
    esac
}

discover_symbols() {
    local file base family declaration name kind
    while IFS=: read -r file _ declaration; do
        base="${file##*/}"
        family="$(family_for_file "$base")"
        name="$(sed -E 's/.*fun[[:space:]]+([A-Za-z0-9_]+).*/\1/' <<<"$declaration")"
        if [[ "$name" == *Dialog ]]; then kind='dialog'; else kind='page'; fi
        printf 'symbol:%s.%s\t%s\t%s\t%s\n' "${base%.kt}" "$name" "$family" "$kind" "${file#"${PROJECT_ROOT}/"}"
    done < <(
        rg -n --no-heading \
            '^[[:space:]]*(internal[[:space:]]+|private[[:space:]]+|public[[:space:]]+)?fun[[:space:]]+[A-Z][A-Za-z0-9_]*(Dialog|Screen|Content|Page|Route|Landing)[[:space:]]*\(' \
            "$SOURCE_ROOT" -g '*.kt' | sort
    )
}

discover_modal_calls() {
    local file base family
    while IFS= read -r file; do
        base="${file##*/}"
        family="$(family_for_file "$base")"
        awk -v base="${base%.kt}" -v family="$family" -v owner="${file#"${PROJECT_ROOT}/"}" '
            function emit(kind) {
                key = function_name SUBSEP kind
                count[key]++
                printf "call:%s.%s.%s-%03d\t%s\t%s\t%s\n", base, function_name, kind, count[key], family, kind, owner
            }
            {
                declaration = ($0 ~ /fun[[:space:]]+[A-Za-z0-9_]+[[:space:]]*\(/)
                if (declaration) {
                    signature = $0
                    sub(/^.*fun[[:space:]]+/, "", signature)
                    sub(/[[:space:]]*\(.*/, "", signature)
                    function_name = signature
                }
                if (function_name == "") function_name = "file"
                if (!declaration && $0 ~ /PaneAwareAlertDialog[[:space:]]*\(/) emit("dialog")
                else if (!declaration && $0 ~ /(^|[^A-Za-z0-9_])Dialog[[:space:]]*\(/) emit("dialog")
                if (!declaration && $0 ~ /(^|[^A-Za-z0-9_])(DropdownMenu|ExposedDropdownMenu)[[:space:]]*\(/) emit("menu")
            }
        ' "$file"
    done < <(find "$SOURCE_ROOT" -type f -name '*.kt' | sort)
}

discover_all() {
    printf 'source_key\tfamily\tdiscovery_kind\towner\n'
    {
        discover_symbols
        discover_modal_calls
    } | sort -u
}

source_snapshot() {
    local discovered family count digest
    discovered="$(mktemp)"
    discover_all | tail -n +2 > "$discovered"
    printf 'family\tdiscovered_owners\tsha256\n'
    while IFS= read -r family; do
        count="$(awk -F '\t' -v family="$family" '$2 == family { n++ } END { print n+0 }' "$discovered")"
        digest="$(awk -F '\t' -v family="$family" '$2 == family' "$discovered" | sha256sum | cut -d' ' -f1)"
        printf '%s\t%s\t%s\n' "$family" "$count" "$digest"
    done < <(cut -f2 "$discovered" | sort -u)
    count="$(wc -l < "$discovered" | tr -d ' ')"
    digest="$(sha256sum "$discovered" | cut -d' ' -f1)"
    printf 'all\t%s\t%s\n' "$count" "$digest"
    rm -f "$discovered"
}

validate_catalog_rows() {
    [[ -f "$CATALOG_FILE" ]] || die "catalog not found: $CATALOG_FILE"
    local expected_header
    expected_header=$'source_keys\tsurface_id\tfamily\tkind\tstate\tcapture_selector\tdisposition\tnotes'
    [[ "$(head -n 1 "$CATALOG_FILE")" == "$expected_header" ]] ||
        die "catalog header must be: $expected_header"

    awk -F '\t' '
        NR == 1 { next }
        NF != 8 { printf "line %d has %d columns, expected 8\n", NR, NF > "/dev/stderr"; bad=1; next }
        $1 == "" || $2 == "" || $3 == "" || $4 == "" || $5 == "" || $6 == "" || $7 == "" {
            printf "line %d has a blank required field\n", NR > "/dev/stderr"; bad=1
        }
        $2 !~ /^[a-z0-9][a-z0-9._-]*$/ {
            printf "line %d has unsafe surface_id %s\n", NR, $2 > "/dev/stderr"; bad=1
        }
        $3 !~ /^(shared|tasks|habits|goals|tracks|gym|settings|organization)$/ {
            printf "line %d has invalid family %s\n", NR, $3 > "/dev/stderr"; bad=1
        }
        seen[$2]++ { printf "line %d duplicates surface_id %s\n", NR, $2 > "/dev/stderr"; bad=1 }
        source[$1]++ { printf "line %d duplicates source_keys %s\n", NR, $1 > "/dev/stderr"; bad=1 }
        $4 !~ /^(page|dialog|menu|system|widget)$/ {
            printf "line %d has invalid kind %s\n", NR, $4 > "/dev/stderr"; bad=1
        }
        $7 !~ /^(capture|platform-exception)$/ {
            printf "line %d has invalid disposition %s\n", NR, $7 > "/dev/stderr"; bad=1
        }
        END { exit bad }
    ' "$CATALOG_FILE"
}

validate_discovery_coverage() {
    [[ -f "$SOURCE_SNAPSHOT_FILE" ]] || die "source snapshot not found: $SOURCE_SNAPSHOT_FILE"
    local current difference
    current="$(mktemp)"
    source_snapshot > "$current"
    difference="$(diff -u "$SOURCE_SNAPSHOT_FILE" "$current" || true)"
    rm -f "$current"
    [[ -z "$difference" ]] || {
        printf 'UI source discovery changed; review the catalog and refresh the source snapshot:\n%s\n' "$difference" >&2
        return 1
    }
}

lint_catalog() {
    local allow_pending="$1"
    validate_catalog_rows
    validate_discovery_coverage
    local pending_count capture_count exception_count
    pending_count="$(awk -F '\t' 'NR > 1 && $6 == "pending" { n++ } END { print n+0 }' "$CATALOG_FILE")"
    capture_count="$(awk -F '\t' 'NR > 1 && $7 == "capture" { n++ } END { print n+0 }' "$CATALOG_FILE")"
    exception_count="$(awk -F '\t' 'NR > 1 && $7 == "platform-exception" { n++ } END { print n+0 }' "$CATALOG_FILE")"
    printf 'UI catalog: %s required captures, %s platform exceptions, %s pending selectors.\n' \
        "$capture_count" "$exception_count" "$pending_count"
    if [[ "$pending_count" -gt 0 && "$allow_pending" != true ]]; then
        die "$pending_count catalog rows still have pending capture selectors"
    fi
}

write_review_report() {
    local capture_dir="$1"
    local report="$capture_dir/index.html"
    local capture_catalog="$capture_dir/catalog.tsv"
    local manifest="$capture_dir/manifest.tsv"
    [[ -f "$capture_catalog" ]] || die "capture catalog not found: $capture_catalog"
    [[ -f "$manifest" ]] || die "capture manifest not found: $manifest"

    local surface_count
    surface_count="$(($(wc -l < "$manifest") - 1))"
    cat > "$report" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Whip UI catalog review</title>
<style>
:root{color-scheme:dark;background:#0b0c0f;color:#f4f1ea;font:15px/1.45 system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0}header{position:sticky;top:0;z-index:2;padding:18px 22px;background:#111318ee;border-bottom:1px solid #30333b;backdrop-filter:blur(12px)}
h1{font-size:22px;margin:0 0 4px}.summary{color:#aaaeb8;margin:0 0 14px}.controls{display:flex;gap:10px;flex-wrap:wrap}
input,select{min-height:42px;border:1px solid #3b3f48;border-radius:10px;background:#1a1d23;color:inherit;padding:0 12px;font:inherit}input{flex:1;min-width:220px}
main{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;padding:22px}.card{overflow:hidden;border:1px solid #30333b;border-radius:16px;background:#15171c;box-shadow:0 8px 24px #0005}
.shot{display:block;width:100%;aspect-ratio:9/20;object-fit:contain;background:#050506}.meta{padding:14px}.eyebrow{color:#aaaeb8;font-size:12px;text-transform:uppercase;letter-spacing:.08em}
h2{font-size:16px;margin:4px 0 8px;overflow-wrap:anywhere}.state{display:inline-block;border-radius:999px;background:#282b32;padding:3px 8px;font-size:12px}.notes{min-height:42px;color:#c9cbd1}
.links{display:flex;gap:14px}a{color:#e7c787}.empty{display:none;padding:36px;text-align:center;color:#aaaeb8}.hidden{display:none}
</style>
</head>
<body>
<header><h1>Whip UI catalog review</h1><p class="summary">${surface_count} exact page, dialog, menu, system, and widget states. Search or filter to review the design language systematically.</p>
<div class="controls"><input id="query" type="search" placeholder="Search surfaces, states, or notes" aria-label="Search catalog"><select id="family" aria-label="Filter by family"><option value="">All families</option><option>shared</option><option>tasks</option><option>habits</option><option>goals</option><option>tracks</option><option>gym</option><option>settings</option><option>organization</option></select><select id="kind" aria-label="Filter by kind"><option value="">All kinds</option><option>page</option><option>dialog</option><option>menu</option><option>system</option><option>widget</option></select></div></header>
<main id="gallery">
EOF
    awk -F '\t' '
        function escape(value) {
            gsub(/&/, "\\&amp;", value); gsub(/</, "\\&lt;", value); gsub(/>/, "\\&gt;", value)
            gsub(/"/, "\\&quot;", value); return value
        }
        FNR == NR {
            if (FNR > 1) {
                family[$2]=$3; kind[$2]=$4; state[$2]=$5; notes[$2]=$8
            }
            next
        }
        FNR > 1 {
            id=$1
            searchable=tolower(id " " family[id] " " kind[id] " " state[id] " " notes[id])
            printf "<article class=\"card\" data-family=\"%s\" data-kind=\"%s\" data-search=\"%s\">\n", escape(family[id]), escape(kind[id]), escape(searchable)
            printf "<a href=\"raw/%s.png\"><img class=\"shot\" loading=\"lazy\" src=\"raw/%s.png\" alt=\"%s screenshot\"></a>\n", escape(id), escape(id), escape(id)
            printf "<div class=\"meta\"><div class=\"eyebrow\">%s · %s</div><h2>%s</h2><span class=\"state\">%s</span><p class=\"notes\">%s</p>", escape(family[id]), escape(kind[id]), escape(id), escape(state[id]), escape(notes[id])
            printf "<div class=\"links\"><a href=\"raw/%s.png\">PNG</a><a href=\"raw/%s.xml\">Semantics XML</a></div></div></article>\n", escape(id), escape(id)
        }
    ' "$capture_catalog" "$manifest" >> "$report"
    cat >> "$report" <<'EOF'
</main><p id="empty" class="empty">No catalog surfaces match these filters.</p>
<script>
const q=document.querySelector('#query'),family=document.querySelector('#family'),kind=document.querySelector('#kind'),cards=[...document.querySelectorAll('.card')],empty=document.querySelector('#empty');
function filter(){const text=q.value.trim().toLowerCase();let shown=0;for(const card of cards){const visible=(!text||card.dataset.search.includes(text))&&(!family.value||card.dataset.family===family.value)&&(!kind.value||card.dataset.kind===kind.value);card.classList.toggle('hidden',!visible);if(visible)shown++}empty.style.display=shown?'none':'block'}
q.addEventListener('input',filter);family.addEventListener('change',filter);kind.addEventListener('change',filter);
</script></body></html>
EOF
    printf 'Wrote review gallery for %s catalog surfaces to %s.\n' "$surface_count" "$report"
}

capture_catalog() {
    local output_dir="$1" allow_pending="$2" selected_family="$3"
    lint_catalog "$allow_pending"
    "${SCRIPT_DIR}/android-target-guard" instrumentation
    [[ ! -e "$output_dir" || -d "$output_dir" ]] || die "output path is not a directory: $output_dir"
    mkdir -p "$output_dir"
    [[ -z "$(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
        die "output directory must be empty: $output_dir"

    local serial="$ANDROID_SERIAL"
    capture_serial="$serial"
    capture_previous_night_mode="$(adb -s "$serial" shell cmd uimode night | sed -n 's/^Night mode: //p' | tr -d '\r')"
    [[ "$capture_previous_night_mode" =~ ^(yes|no|auto)$ ]] ||
        die "could not determine emulator night mode: ${capture_previous_night_mode:-missing}"
    capture_previous_hide_error_dialogs="$(adb -s "$serial" shell settings get global hide_error_dialogs | tr -d '\r')"
    [[ "$capture_previous_hide_error_dialogs" =~ ^(null|0|1)$ ]] ||
        die "could not determine emulator error-dialog setting: ${capture_previous_hide_error_dialogs:-missing}"
    trap restore_capture_environment EXIT
    adb -s "$serial" shell cmd uimode night yes >/dev/null
    # Background Google processes on the stock AVD can crash independently of
    # Whip. Suppress those OS sheets during evidence collection, while the
    # hierarchy guard still rejects any overlay that reaches a captured frame.
    adb -s "$serial" shell settings put global hide_error_dialogs 1 >/dev/null
    adb -s "$serial" shell content delete \
        --uri "$DEVICE_DOWNLOADS_URI" \
        --where "relative_path=\\'${DEVICE_CAPTURE_RELATIVE_PATH}\\'" >/dev/null
    adb -s "$serial" shell rm -rf "$DEVICE_CAPTURE_ROOT"

    local -a selectors=()
    mapfile -t selectors < <(
        awk -F '\t' -v family="$selected_family" \
            'NR > 1 && $7 == "capture" && $6 != "pending" && (family == "" || $3 == family) { print $6 }' \
            "$CATALOG_FILE" | sort -u
    )
    [[ "${#selectors[@]}" -gt 0 ]] || die 'no implemented catalog captures matched the requested scope'
    local -a qa_args=()
    local selector
    for selector in "${selectors[@]}"; do qa_args+=(--android "$selector"); done
    ANDROID_SERIAL="$serial" "${SCRIPT_DIR}/qa-targeted" "${qa_args[@]}"

    mkdir -p "$output_dir/raw"
    adb -s "$serial" pull "$DEVICE_CAPTURE_ROOT/." "$output_dir/raw" >/dev/null
    cp "$CATALOG_FILE" "$output_dir/catalog.tsv"

    local expected actual missing unexpected
    expected="$(mktemp)"
    actual="$(mktemp)"
    awk -F '\t' -v family="$selected_family" \
        'NR > 1 && $7 == "capture" && $6 != "pending" && (family == "" || $3 == family) { print $2 ".png"; print $2 ".xml" }' \
        "$CATALOG_FILE" | sort -u > "$expected"
    find "$output_dir/raw" -maxdepth 1 -type f -printf '%f\n' | rg '\.(png|xml)$' | sort -u > "$actual"
    missing="$(comm -23 "$expected" "$actual")"
    unexpected="$(comm -13 "$expected" "$actual")"
    [[ -z "$missing" ]] || die "capture evidence is missing: ${missing//$'\n'/, }"
    [[ -z "$unexpected" ]] || die "capture produced uncatalogued evidence: ${unexpected//$'\n'/, }"
    rm -f "$expected" "$actual"

    printf 'surface_id\tpng_sha256\tpng_bytes\txml_sha256\txml_bytes\n' > "$output_dir/manifest.tsv"
    while IFS= read -r surface_id; do
        local png xml
        png="$output_dir/raw/${surface_id}.png"
        xml="$output_dir/raw/${surface_id}.xml"
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$surface_id" \
            "$(sha256sum "$png" | awk '{print $1}')" "$(stat -c %s "$png")" \
            "$(sha256sum "$xml" | awk '{print $1}')" "$(stat -c %s "$xml")" \
            >> "$output_dir/manifest.tsv"
    done < <(
        awk -F '\t' -v family="$selected_family" \
            'NR > 1 && $7 == "capture" && $6 != "pending" && (family == "" || $3 == family) { print $2 }' \
            "$CATALOG_FILE" | sort -u
    )
    write_review_report "$output_dir"
    printf 'Captured %s catalog surfaces into %s.\n' "$(($(wc -l < "$output_dir/manifest.tsv") - 1))" "$output_dir"
    restore_capture_environment
    trap - EXIT
    capture_serial=''
    capture_previous_night_mode=''
    capture_previous_hide_error_dialogs=''
}

main() {
    local command="${1:-}"
    case "$command" in
        discover)
            discover_all
            ;;
        source-snapshot)
            source_snapshot
            ;;
        lint)
            local allow_pending=false
            [[ "${2:-}" != '--allow-pending' ]] || allow_pending=true
            lint_catalog "$allow_pending"
            ;;
        report)
            [[ -n "${2:-}" ]] || die 'report requires CAPTURE_DIRECTORY'
            [[ -z "${3:-}" ]] || die 'report accepts one CAPTURE_DIRECTORY'
            write_review_report "$2"
            ;;
        capture)
            shift
            local allow_pending=false selected_family='' output_dir=''
            while (($#)); do
                case "$1" in
                    --allow-pending) allow_pending=true ;;
                    --family)
                        shift
                        (($#)) || die '--family requires a catalog family'
                        selected_family="$1"
                        [[ "$selected_family" =~ ^(shared|tasks|habits|goals|tracks|gym|settings|organization)$ ]] ||
                            die "unknown catalog family: $selected_family"
                        ;;
                    -*) die "unknown capture option: $1" ;;
                    *)
                        [[ -z "$output_dir" ]] || die 'capture accepts one OUTPUT_DIRECTORY'
                        output_dir="$1"
                        ;;
                esac
                shift
            done
            [[ -n "$output_dir" ]] || die 'capture requires OUTPUT_DIRECTORY'
            capture_catalog "$output_dir" "$allow_pending" "$selected_family"
            ;;
        -h|--help|'') usage ;;
        *) usage >&2; die "unknown command: $command" ;;
    esac
}

main "$@"
