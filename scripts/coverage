#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
run_emulator=false

usage() {
    printf '%s\n' \
        'Generate and verify Whip code-coverage reports.' \
        '' \
        'Usage:' \
        '  scripts/coverage             Deterministic JVM coverage' \
        '  scripts/coverage --emulator  JVM plus complete E2E coverage on a disposable emulator' \
        '' \
        'Set ANDROID_SERIAL to exactly one API 34+ disposable emulator.'
}

while (($#)); do
    case "$1" in
        --emulator) run_emulator=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; printf 'error: unknown option %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

if [[ "$run_emulator" == true ]]; then
    "${SCRIPT_DIR}/android-target-guard" instrumentation
    readonly test_serial="$ANDROID_SERIAL"
    emulator_api="$(adb -s "$test_serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    if [[ ! "$emulator_api" =~ ^[0-9]+$ ]] || ((emulator_api < 34)); then
        printf 'error: E2E coverage requires an API 34+ emulator; %s reports API %s\n' "$test_serial" "$emulator_api" >&2
        exit 1
    fi
fi

cd "$PROJECT_ROOT"
./gradlew :app:createDebugUnitTestCoverageReport
java scripts/CoverageGate.java unit app/build/reports/coverage/test/debug/report.xml

if [[ "$run_emulator" == true ]]; then
    mapfile -t instrumentation_test_files < <(find app/src/androidTest -name '*Test.kt' -type f | sort)
    mapfile -t instrumentation_shared_files < <(find app/src/androidTest -type f ! -name '*Test.kt' | sort)
    instrumentation_classes=()
    for test_file in "${instrumentation_test_files[@]}"; do
        test_package="$(sed -nE 's/^package[[:space:]]+([^[:space:]]+).*/\1/p' "$test_file" | head -n 1)"
        test_class="$(basename "$test_file" .kt)"
        if [[ -z "$test_package" ]] ||
            ! grep -Eq "^(internal[[:space:]]+)?class[[:space:]]+${test_class}([[:space:]:<{]|$)" "$test_file"; then
            printf 'error: instrumentation test file must declare its filename as a top-level class: %s\n' \
                "$test_file" >&2
            exit 1
        fi
        instrumentation_classes+=("${test_package}.${test_class}")
    done
    if [[ "${#instrumentation_classes[@]}" -eq 0 ]]; then
        printf 'error: no instrumentation test classes found\n' >&2
        exit 1
    fi

    # Match scripts/check's healthy process topology exactly: isolate the
    # graphics-heavy class first, group ordinary classes by ten, and isolate
    # the whole-app data-epoch reset last so its teardown cannot poison later
    # repositories. Coverage never reuses check's batch cache.
    readonly graphics_test_class='com.whip.app.ui.InteractionControlUiTest'
    readonly destructive_reset_test_class='com.whip.app.DataEpochResetIntegrationTest'
    readonly instrumentation_batch_size=10
    readonly expected_coverage_processes=11
    remaining_instrumentation_classes=()
    graphics_test_found=false
    destructive_reset_test_found=false
    for test_class in "${instrumentation_classes[@]}"; do
        if [[ "$test_class" == "$graphics_test_class" ]]; then
            graphics_test_found=true
        elif [[ "$test_class" == "$destructive_reset_test_class" ]]; then
            destructive_reset_test_found=true
        else
            remaining_instrumentation_classes+=("$test_class")
        fi
    done
    if [[ "$graphics_test_found" != true || "$destructive_reset_test_found" != true ]]; then
        printf 'error: coverage topology requires %s first and %s last\n' \
            "$graphics_test_class" "$destructive_reset_test_class" >&2
        exit 1
    fi

    batch_total="$(((${#remaining_instrumentation_classes[@]} + instrumentation_batch_size - 1) / instrumentation_batch_size + 2))"
    if [[ "$batch_total" -ne "$expected_coverage_processes" ]]; then
        printf 'error: expected the reviewed %s-process coverage topology, calculated %s; reconcile scripts/check and scripts/coverage\n' \
            "$expected_coverage_processes" "$batch_total" >&2
        exit 1
    fi

    coverage_run_dir="$(mktemp -d "${PROJECT_ROOT}/build/coverage-results-XXXXXX")"
    readonly coverage_run_dir
    coverage_execution_data_dir="${coverage_run_dir}/execution-data"
    readonly coverage_execution_data_dir
    mkdir -p "$coverage_execution_data_dir"
    aggregate_result="${coverage_run_dir}/aggregate.tsv"
    readonly aggregate_result
    printf 'batch\texpected_classes\texecuted_classes\texecuted\tfailures\tskipped\tcoverage_bytes\n' \
        > "$aggregate_result"
    executed_test_total=0
    failed_test_total=0
    skipped_test_total=0

    signature_for_files() {
        local namespace="$1"
        shift
        {
            printf 'namespace:%s\n' "$namespace"
            local source_file
            for source_file in "$@"; do
                printf 'path:%s\n' "$source_file"
                sha256sum "$source_file"
            done
        } | sha256sum | awk '{ print $1 }'
    }

    mapfile -t coverage_signature_files < <(
        {
            find app/src -type f
            find gradle -type f
            printf '%s\n' \
                app/build.gradle.kts \
                build.gradle.kts \
                settings.gradle.kts \
                gradle.properties \
                scripts/android-target-guard \
                scripts/coverage
        } | sort -u
    )
    coverage_source_signature="$(
        signature_for_files 'whip-batched-android-coverage-v1' "${coverage_signature_files[@]}"
    )"
    readonly coverage_source_signature

    require_unchanged_coverage_sources() {
        local boundary="$1"
        local current_signature
        current_signature="$(
            signature_for_files 'whip-batched-android-coverage-v1' "${coverage_signature_files[@]}"
        )"
        if [[ "$current_signature" != "$coverage_source_signature" ]]; then
            printf 'error: coverage source/build signature changed %s; discard this run: %s\n' \
                "$boundary" "$coverage_run_dir" >&2
            exit 1
        fi
    }

    clear_previous_batch_outputs() {
        local result_root='app/build/outputs/androidTest-results/connected'
        local coverage_root='app/build/outputs/code_coverage/debugAndroidTest/connected'
        if [[ -d "$result_root" ]]; then
            find "$result_root" -type f -name 'TEST-*.xml' -delete
        fi
        if [[ -d "$coverage_root" ]]; then
            find "$coverage_root" -type f -name '*.ec' -delete
        fi
    }

    capture_coverage_batch() {
        local batch_number="$1"
        local expected_class_argument="$2"
        local batch_marker="$3"
        local gradle_status="$4"
        local batch_report_dir="${coverage_run_dir}/batch-${batch_number}"
        mkdir -p "$batch_report_dir"

        mapfile -t batch_xml < <(
            find app/build/outputs/androidTest-results/connected \
                -name 'TEST-*.xml' -type f -newer "$batch_marker" 2>/dev/null | sort
        )
        if [[ "${#batch_xml[@]}" -eq 0 ]]; then
            printf 'error: coverage batch %s produced no fresh executable XML; results retained in %s\n' \
                "$batch_number" "$coverage_run_dir" >&2
            exit 1
        fi
        local xml_number=0
        local result_xml
        for result_xml in "${batch_xml[@]}"; do
            xml_number="$((xml_number + 1))"
            cp -- "$result_xml" "${batch_report_dir}/result-${xml_number}.xml"
        done

        local expected_class_file="${batch_report_dir}/expected-classes.txt"
        local executed_class_file="${batch_report_dir}/executed-classes.txt"
        tr ',' '\n' <<< "$expected_class_argument" | sed '/^$/d' | sort -u > "$expected_class_file"
        (grep -Rho 'classname="[^"]*"' "$batch_report_dir" || true) \
            | sed -E 's/^classname="([^"]*)"$/\1/' \
            | sed '/^$/d' \
            | sort -u > "$executed_class_file"
        if ! cmp -s "$expected_class_file" "$executed_class_file"; then
            printf 'error: coverage batch %s executed a different class set than requested; results retained in %s\n' \
                "$batch_number" "$coverage_run_dir" >&2
            diff -u "$expected_class_file" "$executed_class_file" >&2 || true
            exit 1
        fi

        local expected_class_count executed_class_count executed failures skipped
        expected_class_count="$(wc -l < "$expected_class_file" | tr -d ' ')"
        executed_class_count="$(wc -l < "$executed_class_file" | tr -d ' ')"
        executed="$( (grep -Rho '<testcase[ >]' "$batch_report_dir" || true) | wc -l | tr -d ' ')"
        failures="$( (grep -RhoE '<(failure|error)[ >]' "$batch_report_dir" || true) | wc -l | tr -d ' ')"
        skipped="$( (grep -Rho '<skipped[ >]' "$batch_report_dir" || true) | wc -l | tr -d ' ')"
        if [[ "$executed" -eq 0 || "$failures" -ne 0 || "$skipped" -ne 0 ]]; then
            printf 'error: coverage batch %s requires nonzero tests and zero failures/skips; got %s/%s/%s; results retained in %s\n' \
                "$batch_number" "$executed" "$failures" "$skipped" "$coverage_run_dir" >&2
            exit 1
        fi
        if [[ "$gradle_status" -ne 0 ]]; then
            printf 'error: coverage batch %s Gradle task failed with status %s; results retained in %s\n' \
                "$batch_number" "$gradle_status" "$coverage_run_dir" >&2
            exit "$gradle_status"
        fi

        mapfile -t batch_coverage_files < <(
            find app/build/outputs/code_coverage/debugAndroidTest/connected \
                -name '*.ec' -type f -newer "$batch_marker" 2>/dev/null | sort
        )
        if [[ "${#batch_coverage_files[@]}" -ne 1 || ! -s "${batch_coverage_files[0]:-}" ]]; then
            printf 'error: coverage batch %s requires exactly one nonempty fresh .ec file; found %s; results retained in %s\n' \
                "$batch_number" "${#batch_coverage_files[@]}" "$coverage_run_dir" >&2
            exit 1
        fi
        local batch_id copied_coverage_file coverage_bytes
        printf -v batch_id '%02d' "$batch_number"
        copied_coverage_file="${coverage_execution_data_dir}/batch-${batch_id}.ec"
        cp -- "${batch_coverage_files[0]}" "$copied_coverage_file"
        if [[ ! -s "$copied_coverage_file" ]]; then
            printf 'error: copied coverage data is empty for batch %s: %s\n' \
                "$batch_number" "$copied_coverage_file" >&2
            exit 1
        fi
        coverage_bytes="$(wc -c < "$copied_coverage_file" | tr -d ' ')"

        executed_test_total="$((executed_test_total + executed))"
        failed_test_total="$((failed_test_total + failures))"
        skipped_test_total="$((skipped_test_total + skipped))"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$batch_number" "$expected_class_count" "$executed_class_count" "$executed" \
            "$failures" "$skipped" "$coverage_bytes" >> "$aggregate_result"
    }

    run_coverage_batch() {
        local batch_number="$1"
        local class_argument="$2"
        local batch_marker="${coverage_run_dir}/batch-${batch_number}.started"
        local gradle_status

        # Revalidate immediately before every nested connected task. The task's
        # module-local Gradle doFirst guard independently enforces the same pin.
        ANDROID_SERIAL="$test_serial" "${SCRIPT_DIR}/android-target-guard" instrumentation
        clear_previous_batch_outputs
        : > "$batch_marker"
        set +e
        ANDROID_SERIAL="$test_serial" ./gradlew :app:connectedDebugAndroidTest \
            --rerun --no-build-cache --no-configuration-cache --console=plain \
            "-Pandroid.testInstrumentationRunnerArguments.class=${class_argument}"
        gradle_status="$?"
        set -e
        require_unchanged_coverage_sources "during batch ${batch_number}"
        capture_coverage_batch "$batch_number" "$class_argument" "$batch_marker" "$gradle_status"
        adb -s "$test_serial" shell am force-stop commvne.com.whip.app.debug >/dev/null
        adb -s "$test_serial" shell am force-stop commvne.com.whip.app.debug.test >/dev/null
    }

    printf 'Coverage batch 1/%s (graphics interaction class)\n' "$batch_total"
    run_coverage_batch 1 "$graphics_test_class"

    for ((batch_start = 0; batch_start < ${#remaining_instrumentation_classes[@]}; batch_start += instrumentation_batch_size)); do
        batch=("${remaining_instrumentation_classes[@]:batch_start:instrumentation_batch_size}")
        batch_classes="$(IFS=,; printf '%s' "${batch[*]}")"
        batch_number="$((batch_start / instrumentation_batch_size + 2))"
        printf 'Coverage batch %s/%s (%s classes)\n' \
            "$batch_number" "$batch_total" "${#batch[@]}"
        run_coverage_batch "$batch_number" "$batch_classes"
    done

    printf 'Coverage batch %s/%s (destructive data-epoch reset class)\n' "$batch_total" "$batch_total"
    run_coverage_batch "$batch_total" "$destructive_reset_test_class"

    android_test_count="$(
        grep -RhoE --include='*.kt' '^[[:space:]]*@Test([[:space:](]|$)' app/src/androidTest \
            | wc -l | tr -d ' '
    )"
    if [[ "$executed_test_total" -ne "$android_test_count" ||
        "$failed_test_total" -ne 0 ||
        "$skipped_test_total" -ne 0
    ]]; then
        printf 'error: expected %s Android tests with zero failures/skips; XML proves %s/%s/%s; see %s\n' \
            "$android_test_count" "$executed_test_total" "$failed_test_total" \
            "$skipped_test_total" "$aggregate_result" >&2
        exit 1
    fi
    mapfile -t copied_coverage_files < <(find "$coverage_execution_data_dir" -name 'batch-*.ec' -type f | sort)
    if [[ "${#copied_coverage_files[@]}" -ne "$batch_total" ]]; then
        printf 'error: expected %s copied coverage files, found %s; see %s\n' \
            "$batch_total" "${#copied_coverage_files[@]}" "$coverage_run_dir" >&2
        exit 1
    fi

    require_unchanged_coverage_sources 'before report generation'
    ANDROID_SERIAL="$test_serial" ./gradlew :app:createBatchedDebugAndroidTestCoverageReport \
        --rerun --no-build-cache --no-configuration-cache --console=plain \
        "-PwhipAndroidCoverageExecutionDataDir=${coverage_execution_data_dir}" \
        "-PwhipAndroidCoverageExpectedBatchCount=${batch_total}"
    require_unchanged_coverage_sources 'during report generation'
    readonly e2e_report='app/build/reports/coverage/androidTest/debug/connected/report.xml'
    readonly e2e_html='app/build/reports/coverage/androidTest/debug/connected/index.html'
    if [[ ! -s "$e2e_report" || ! -s "$e2e_html" ]]; then
        printf 'error: batched XML/HTML coverage report is missing or empty\n' >&2
        exit 1
    fi
    java scripts/CoverageGate.java e2e "$e2e_report"
    printf 'All %s Android tests passed with zero failures/skips across %s fresh coverage processes. Reports: %s and %s. Evidence: %s\n' \
        "$executed_test_total" "$batch_total" "$e2e_report" "$e2e_html" "$coverage_run_dir"
fi
