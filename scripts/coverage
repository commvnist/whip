#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
run_emulator=false

usage() {
    printf '%s\n' \
        'Generate and verify Whip code-coverage reports.' \
        '' \
        'Usage:' \
        '  scripts/coverage             Deterministic complete JVM coverage' \
        '  scripts/coverage --emulator  Also run complete fresh Android E2E coverage' \
        '' \
        'Android coverage is a compatibility entry point for candidate diagnostics.' \
        'The release authority is ANDROID_SERIAL=emulator-N scripts/candidate.'
}

while (($#)); do
    case "$1" in
        --emulator) run_emulator=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; printf 'error: unknown option %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

if [[ "$run_emulator" == true ]]; then
    "${SCRIPT_DIR}/android-target-guard" instrumentation
fi

cd "$PROJECT_ROOT"
./gradlew :app:createDebugUnitTestCoverageReport
java scripts/CoverageGate.java unit app/build/reports/coverage/test/debug/report.xml

if [[ "$run_emulator" == true ]]; then
    "${SCRIPT_DIR}/android-test-engine" --mode coverage
fi
