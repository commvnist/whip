<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/widget_content_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_whip_mark" />

            <LinearLayout
                android:id="@+id/widget_header"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_habit_tracking_name"
                    android:textColor="@color/widget_primary_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_habit_preview_subtitle"
                    android:textColor="@color/widget_secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_add_habit"
                android:background="@drawable/widget_icon_button_feedback"
                android:foregroundGravity="center">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_add_surface"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/widget_ic_add" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_habit_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:fadeScrollbars="true"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_content_surface"
                android:gravity="center"
                android:maxLines="3"
                android:padding="12dp"
                android:text="@string/widget_habit_empty"
                android:textColor="@color/widget_primary_text"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
