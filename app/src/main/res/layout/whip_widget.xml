<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFBFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E8DEF8"
        android:textSize="12sp"
        android:text="@string/widget_today_all_areas" />

    <LinearLayout
        android:id="@+id/widget_metrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_task_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 tasks due"
            android:textColor="#FFFBFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_habit_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 habits due"
            android:textColor="#FFFBFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_add_task"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:text="@string/widget_add_task"
            android:textColor="#FFFBFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_add_habit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:text="@string/widget_add_habit"
            android:textColor="#FFFBFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
