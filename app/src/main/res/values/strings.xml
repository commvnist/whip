    <string name="health_rationale_page_supporting">Private, read-only health context for your goals and insights.</string>
    <string name="health_rationale_read_only_title">Read-only by design</string>
    <string name="health_rationale_read_only_message">Whip only reads the health categories you select. It never writes to Health Connect.</string>
    <string name="health_rationale_storage_title">How imported data is used</string>
    <string name="health_rationale_storage_message">Whip keeps a private local copy of imported values so they can contribute to goals, trends, and insights alongside activity you record yourself.</string>
    <string name="health_rationale_privacy_title">Your privacy and control</string>
    <string name="health_rationale_privacy_message">Whip does not sell or upload your health data. You can review or revoke access in Health Connect at any time.</string>
    <string name="health_rationale_sync_title">Turning sync off</string>
    <string name="health_rationale_sync_message">Turning off sync stops future reads. It does not delete records already imported into Whip. You remain in control of those records through Whip’s data controls.</string>
